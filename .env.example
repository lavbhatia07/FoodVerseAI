# ====================================================================
# FoodVerse AI — Environment Configuration Template
# ====================================================================

# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=info

# CORS Origins (comma-separated list of allowed frontend URLs)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Database & Storage Configuration
# SQLite local file or PostgreSQL (e.g., postgresql+psycopg2://user:pass@localhost:5432/foodverse)
DATABASE_URL=sqlite:///./data/foodverse.db
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE_MB=50

# AI Provider Configurations
# LLM Providers: 'local' (built-in intelligent culinary reasoning), 'openai', 'gemini'
LLM_PROVIDER=local
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=

# Vision Providers: 'local' (built-in Food-101 / CV heuristics feature extractor), 'openai', 'gemini'
VISION_PROVIDER=local
VISION_MODEL=food-vision-v1
VISION_API_KEY=

# Nutrition Data Provider
# Leave blank to use FoodVerse verified local USDA FoodData composition database
NUTRITION_PROVIDER=local
NUTRITION_API_KEY=

# Frontend Environment Variables (for Vite development)
VITE_API_BASE_URL=http://localhost:8000/api/v1
